{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Keep avenir-mcp's dependencies current. Tooling merges itself once CI passes; what runs in front of users' budgets is reviewed by hand.",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": false,
  "semanticCommitType": "build",
  "semanticCommitScope": "deps",
  "commitBody": "Signed-off-by: {{{gitAuthor}}}",
  "timezone": "Europe/Paris",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 3,
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ],
    "minimumReleaseAge": null,
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "description": "Development tools and CI actions move together: one pull request, merged once CI passes.",
      "matchManagers": [
        "pep621",
        "github-actions",
        "pre-commit"
      ],
      "matchDepTypes": [
        "dependency-groups",
        "action",
        "repository"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "development tooling",
      "automerge": true
    },
    {
      "description": "The documentation site (Astro, Starlight): one grouped pull request, merged once the docs build passes.",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "docs/package.json"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "documentation site",
      "automerge": true
    },
    {
      "description": "fastmcp, the MCP SDK it builds on, httpx and pydantic run in front of users' budgets. Each update is reviewed on its own, and the evaluation is run before merging a fastmcp or mcp update.",
      "matchPackageNames": [
        "fastmcp",
        "mcp",
        "mcp-types",
        "starlette",
        "httpx",
        "pydantic"
      ],
      "groupName": null,
      "automerge": false
    },
    {
      "description": "Major versions change what the build accepts or how the code behaves: reviewed one at a time.",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "automerge": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "minimumReleaseAge": null,
    "schedule": [
      "before 6am on monday"
    ],
    "automerge": true
  },
  "pre-commit": {
    "enabled": true
  }
}
