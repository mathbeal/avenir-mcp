---
// What is left in each category at the end of a month (YNAB's Available), drawn from a
// real get_budget_vs_actual answer. A share of the budget used says little about a bill
// (paying the electricity is not "92 %" of anything); the amount left says the same for
// every category. One series, one hue (validated light and dark), bars from zero; an
// overspent category turns to the status colour and says so in words.
// Hover shows budgeted, spent and left; a table gives the same numbers without the picture.
interface Row {
  name: string;
  group: string;
  budgeted: number;
  actual: number;
  balance: number;
}
interface Props {
  rows: Row[];
  month: string;
}

const texts = {
  en: {
    title: 'What is left in each category',
    source: 'Answer of get_budget_vs_actual on the demo plan',
    overspent: 'overspent by',
    table: 'Show as a table',
    category: 'Category',
    budgeted: 'Budgeted',
    spent: 'Spent',
    remaining: 'Left',
    note: '',
    names: {} as Record<string, string>,
  },
  fr: {
    title: 'Ce qui reste dans chaque catégorie',
    source: 'Réponse de get_budget_vs_actual sur le plan de démonstration',
    overspent: 'dépassé de',
    table: 'Afficher en tableau',
    category: 'Catégorie',
    budgeted: 'Budgété',
    spent: 'Dépensé',
    remaining: 'Restant',
    note: 'Noms des catégories adaptés au français ; la réponse brute garde ceux du plan de démonstration.',
    names: {
