---
// Share of each budget used in a month, drawn from a real get_budget_vs_actual answer.
// One series, one hue (validated light and dark); the 100 % line is the budget.
// Hover shows the amounts; a table gives the same numbers without the picture.
interface Row {
  name: string;
  group: string;
  budgeted: number;
  actual: number;
  utilization_pct: number;
}
interface Props {
  rows: Row[];
  month: string;
}

const texts = {
