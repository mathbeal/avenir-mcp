    } as Record<string, string>,
  },
  es: {
    title: 'Lo que queda en cada categoría',
    source: 'Respuesta de get_budget_vs_actual sobre el plan de demostración',
    overspent: 'excedido en',
    table: 'Ver como tabla',
    category: 'Categoría',
    budgeted: 'Presupuestado',
    spent: 'Gastado',
