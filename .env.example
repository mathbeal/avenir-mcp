# Required. YNAB → Account Settings → Developer Settings → New Token.
YNAB_API_KEY=

# Optional. stdio (default) or http.
AVENIR_MCP_TRANSPORT=stdio
# Optional, HTTP only. Keep the host on localhost.
AVENIR_MCP_HOST=127.0.0.1
AVENIR_MCP_PORT=8103

# Optional. Confidence (0 to 1) above which suggest_category proposes one category.
AVENIR_MCP_CONFIDENCE_THRESHOLD=0.90
