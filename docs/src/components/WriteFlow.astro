---
// The three steps every write goes through.
import { home } from './home-i18n';

const t = home(Astro.locals.starlightRoute.lang);
---

<ol class="flow not-content">
  {
    t.flow.map(([title, text], index) => (
      <li>
        <span class="step">{index + 1}</span>
        <h3>{title}</h3>
        <p>{text}</p>
      </li>
    ))
  }
</ol>

<style>
  .flow {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
    padding: 0;
    margin: 1.5rem 0 0;
    list-style: none;
    counter-reset: none;
  }

  .flow li {
    position: relative;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--sl-color-gray-6) 45%, transparent);
  }

  .step {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--sl-color-accent) 18%, transparent);
    color: var(--sl-color-accent-high);
    font-weight: 700;
  }

  h3 {
    margin: 0.75rem 0 0.35rem;
    font-size: var(--sl-text-lg);
    color: var(--sl-color-white);
  }

  p {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    line-height: 1.6;
  }
</style>
