};

const lang = Astro.locals.starlightRoute.lang as keyof typeof texts;
const t = texts[lang] ?? texts.en;
const locale = { en: 'en-US', fr: 'fr-FR', es: 'es-ES', de: 'de-DE', nl: 'nl-NL' }[lang] ?? 'en-US';
const money = new Intl.NumberFormat(locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const monthName = new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(
  new Date(`${Astro.props.month}T00:00:00Z`),
);

const label = (name: string) => t.names[name] ?? name;
// Groups in YNAB's order; within a group, the most left first.
const groups = [...new Set(Astro.props.rows.map((r) => r.group))].map((group) => ({
  group,
  rows: Astro.props.rows.filter((r) => r.group === group).sort((a, b) => b.balance - a.balance),
}));
const rows = groups.flatMap((g) => g.rows);
const labelW = 128;
const plotW = 340;
const rowH = 24;
const headH = 22;
const barH = 12;
const top = 6;
const width = labelW + plotW + 96;
const layout: ({ kind: 'group'; name: string; y: number } | { kind: 'row'; row: Row; y: number })[] = [];
let cursor = top;
for (const g of groups) {
  layout.push({ kind: 'group', name: label(g.group), y: cursor });
  cursor += headH;
  for (const row of g.rows) {
    layout.push({ kind: 'row', row, y: cursor });
    cursor += rowH;
  }
}
const height = cursor + 4;
const low = Math.min(0, ...rows.map((r) => r.balance));
const high = Math.max(0, ...rows.map((r) => r.balance));
const x = (v: number) => labelW + ((v - low) / (high - low || 1)) * plotW;
const colon = lang === 'fr' ? ' : ' : ': ';
const tipOf = (r: Row) =>
  [
    label(r.name),
    r.balance < 0
      ? `${t.overspent} ${money.format(-r.balance)}`
      : `${t.remaining}${colon}${money.format(r.balance)}`,
    `${t.budgeted}${colon}${money.format(r.budgeted)}`,
    `${t.spent}${colon}${money.format(r.actual)}`,
  ].join(' · ');

// A bar anchored on zero, with a 4 px rounded data end away from it.
function bar(x0: number, x1: number, y: number): string {
  const w = Math.abs(x1 - x0);
  if (w < 0.5) return '';
  const r = Math.min(4, w / 2, barH / 2);
  const s = x1 > x0 ? 1 : -1;
  return `M${x0},${y} H${x1 - s * r} Q${x1},${y} ${x1},${y + r} V${y + barH - r} Q${x1},${y + barH} ${x1 - s * r},${y + barH} H${x0} Z`;
}
---

<figure class="budget-chart not-content">
  <figcaption>
    <strong>{t.title}</strong>
    <span>{monthName}</span>
  </figcaption>
  <div class="plot">
    <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`${t.title}, ${monthName}`}>
      <line class="zero" x1={x(0)} x2={x(0)} y1={top} y2={height - 2} />
      {
        layout.map((item) => {
          if (item.kind === 'group') {
            return (
              <text class="group" x="0" y={item.y + headH / 2 + 3} dominant-baseline="middle">
                {item.name}
              </text>
            );
          }
          const r = item.row;
          const y = item.y + (rowH - barH) / 2;
          const tip = tipOf(r);
          const over = r.balance < 0;
          const end = x(r.balance);
          const value = over ? `${t.overspent} ${money.format(-r.balance)}` : money.format(r.balance);
          return (
            <g class={over ? 'row over' : 'row'} data-tip={tip} tabindex="0" aria-label={tip}>
              <rect class="hit" x="0" y={item.y} width={width} height={rowH} />
              <text class="name" x={labelW - 12} y={y + barH / 2} dominant-baseline="middle" text-anchor="end">
                {label(r.name)}
              </text>
              <path class="fill" d={bar(x(0), end, y)} />
              <text
                class="value"
                x={over ? x(0) + 8 : Math.max(end, x(0)) + 8}
                y={y + barH / 2}
                dominant-baseline="middle"
              >
                {value}
              </text>
            </g>
          );
        })
      }
    </svg>
    <div class="tip" role="status" hidden></div>
  </div>
  <p class="source">{t.source}{t.note && <><br />{t.note}</>}</p>
  <details>
    <summary>{t.table}</summary>
    <table>
      <thead>
        <tr><th>{t.category}</th><th>{t.budgeted}</th><th>{t.spent}</th><th>{t.remaining}</th></tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <td>{label(r.group)} · {label(r.name)}</td>
              <td>{money.format(r.budgeted)}</td>
              <td>{money.format(r.actual)}</td>
              <td>{money.format(r.balance)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>
</figure>

<script>
  // One tooltip per chart, following the pointer or the focused row.
  for (const chart of document.querySelectorAll<HTMLElement>('.budget-chart')) {
    const plot = chart.querySelector<HTMLElement>('.plot')!;
    const tip = chart.querySelector<HTMLElement>('.tip')!;
    const show = (row: Element, px: number, py: number) => {
      tip.textContent = row.getAttribute('data-tip');
      tip.hidden = false;
      const box = plot.getBoundingClientRect();
      tip.style.left = `${Math.min(px - box.left + 12, box.width - tip.offsetWidth - 4)}px`;
      tip.style.top = `${py - box.top - tip.offsetHeight - 10}px`;
    };
    for (const row of chart.querySelectorAll('.row')) {
      row.addEventListener('pointermove', (e) => {
        const ev = e as PointerEvent;
        show(row, ev.clientX, ev.clientY);
      });
      row.addEventListener('pointerleave', () => (tip.hidden = true));
      row.addEventListener('focus', () => {
        const r = row.getBoundingClientRect();
        show(row, r.left + r.width / 3, r.top + r.height / 2);
      });
      row.addEventListener('blur', () => (tip.hidden = true));
    }
  }
</script>

<style>
  .budget-chart {
    /* Bar colours validated with the dataviz palette checks, one per theme. */
    --viz-bar: #1a9e8c;
    --viz-critical: #d03b3b;
    max-width: 40rem;
    margin: 1.5rem 0 0;
    padding: 1.25rem 1.25rem 1rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--sl-color-gray-6) 35%, transparent);
  }

  :global(:root[data-theme='light']) .budget-chart {
    --viz-bar: #008a7a;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 0.5rem;
    color: var(--sl-color-white);
  }

  figcaption span {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-transform: capitalize;
  }

  .plot {
    position: relative;
    overflow-x: auto;
  }

  svg {
    display: block;
    width: 100%;
    min-width: 26rem;
    height: auto;
    font-family: var(--sl-font);
  }

  .zero {
    stroke: var(--sl-color-gray-4);
    stroke-width: 1;
  }

  .name {
    fill: var(--sl-color-gray-2);
    font-size: 13px;
  }

  .group {
    fill: var(--sl-color-white);
    font-size: 12px;
    font-weight: 600;
  }

  .value {
    fill: var(--sl-color-gray-2);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .fill {
    fill: var(--viz-bar);
  }

  /* Overspent: the reserved status colour, always with the words beside it. */
  .over .fill {
    fill: var(--viz-critical);
  }

  .hit {
    fill: transparent;
  }

  .row {
    outline: none;
  }

  .row:hover .name,
  .row:focus-visible .name {
    fill: var(--sl-color-white);
  }

  .row:hover .hit,
  .row:focus-visible .hit {
    fill: color-mix(in srgb, var(--sl-color-gray-5) 25%, transparent);
  }

  .tip {
    position: absolute;
    z-index: 2;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.4rem;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-white);
    font-size: var(--sl-text-xs);
    white-space: nowrap;
    pointer-events: none;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.2);
  }

  .source {
    margin: 0.5rem 0 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  details {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
  }

  summary {
    cursor: pointer;
    color: var(--sl-color-gray-2);
  }

  table {
    width: 100%;
    margin-top: 0.5rem;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  th,
  td {
    padding: 0.3rem 0.5rem;
    border-bottom: 1px solid var(--sl-color-hairline-light);
    text-align: end;
  }

  th:first-child,
  td:first-child {
    text-align: start;
  }
</style>
