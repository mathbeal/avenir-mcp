---
// The notice that avenir-mcp is unofficial, at the foot of every page.
import { branded, home } from './home-i18n';

const t = home(Astro.locals.starlightRoute.lang);
---

<p class="disclaimer not-content" set:html={branded(t.disclaimer)} />

<style>
  .disclaimer {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-hairline-light);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    text-align: center;
  }

  .disclaimer :global(a) {
    color: var(--sl-color-gray-2);
  }

  /* The name keeps its face, not its colour: the notice stays quiet. */
  .disclaimer :global(.brand) {
    color: inherit;
  }
</style>
